# Boardroom — environment configuration.
# Copy to `.env.local` for local dev. With NO credentials the app runs in demo
# mode using the credential-free Mock provider, so you can develop the whole UI
# without any keys.

# Which LLM provider to use: "vertex" | "gemini" | "mock" | "auto" (default).
# "auto" picks Vertex, then Gemini, then Mock — whichever has credentials.
LLM_PROVIDER=auto

# Model id (optional). Defaults to "gemini-2.0-flash".
# GEMINI_MODEL=gemini-2.0-flash

# --- Option A: Gemini via Google AI Studio (easiest local path) -------------
# Get a key at https://aistudio.google.com/app/apikey
# This key also powers the CopilotKit chat layer.
# GEMINI_API_KEY=AIza...

# --- Option B: Gemini via Vertex AI -----------------------------------------
# Requires a GCP project with the Vertex AI API enabled and Application Default
# Credentials (gcloud auth application-default login, a service-account JSON via
# GOOGLE_APPLICATION_CREDENTIALS, or the Cloud Run service identity).
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

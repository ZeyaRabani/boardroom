# Boardroom — environment configuration.
# Copy to `.env.local` for local dev:   cp .env.local.example .env.local
# `.env.local` is git-ignored — NEVER commit real API keys.
#
# With NO credentials the app runs in DEMO MODE using the credential-free Mock
# provider, so you can develop and demo the whole UI without any keys.

# Which LLM provider to use: "vertex" | "gemini" | "mock" | "auto" (default).
# "auto" picks Vertex, then Gemini, then Mock — whichever has credentials.
LLM_PROVIDER=gemini

# Force demo mode (Mock provider) even when a key is present. Leave unset/false
# for normal operation; the app also falls back to demo mode automatically if
# Gemini is unavailable.
# DEMO_MODE=false

# Model id (optional). Defaults to "gemini-2.5-flash".
# GEMINI_MODEL=gemini-2.5-flash

# --- Gemini via Google AI Studio (the path this app uses) -------------------
# Get a key at https://aistudio.google.com/app/apikey
# This key also powers the CopilotKit chat layer.
GEMINI_API_KEY=your-google-ai-studio-key

# --- Optional: Gemini via Vertex AI -----------------------------------------
# Requires a GCP project with the Vertex AI API enabled and Application Default
# Credentials (gcloud auth application-default login, a service-account JSON via
# GOOGLE_APPLICATION_CREDENTIALS, or the Cloud Run service identity).
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
